# === Web UI ===
# Web cache limit in MB (cover art, backgrounds) (default: 500)
# WEB_CACHE_MB=500
# Kill a run started from the web UI after this many minutes. Without it a
# wedged run keeps the UI refusing new runs until it is stopped by hand.
# 0 disables the timeout. (default: 240)
# RUN_TIMEOUT=240

# === Discovery Config ===

# Service which recommends songs (only 'listenbrainz' is supported)
# DISCOVERY_SERVICE=listenbrainz
# Your ListenBrainz username
LISTENBRAINZ_USER=
# User token from ListenBrainz
LISTENBRAINZ_USER_TOKEN=
# 'playlist' to fetch weekly playlist (50 songs), 'api' for fewer songs (good for testing) (default: playlist)
# LISTENBRAINZ_DISCOVERY=playlist
# Enrich playlist tracks with full metadata from metadata/recording endpoint (default: false)
# ENRICH_TRACK_METADATA=false

# === Music System Configuration ===

# Music system you use: emby, jellyfin, mpd, plex or subsonic
EXPLO_SYSTEM=
# Address of your media system (e.g. http://127.0.0.1:4533)
SYSTEM_URL=
# Username with access to system (required for all except mpd)
SYSTEM_USERNAME=
# Password for the user (required for subsonic, recommended for plex)
SYSTEM_PASSWORD=
# API Key from your media system (required for emby and jellyfin, optional for plex)
API_KEY=
# Name of the music library in your system (emby, jellyfin, plex)
LIBRARY_NAME=
# Mark playlist as public (subsonic, jellyfin)
# PUBLIC_PLAYLIST=false
# Minimum score required for a track match (default: 60)
# TRACK_MATCH_SCORE=60

# Optional admin username for systems like Navidrome/Subsonic/Plex (used to trigger operations that need elevated permissions for multi-user setups)
# ADMIN_SYSTEM_USERNAME=
# Optional admin password for systems like Navidrome/Subsonic/Plex
# ADMIN_SYSTEM_PASSWORD=
# Admin API Key for Jellyfin (or Plex when using MFA) (used for multi-user setups)
# ADMIN_API_KEY=

# === Downloader Configuration ===

# Directory to store downloaded tracks. It's recommended to make a separate directory (under the music library) for Explo
# PS! This is only needed when running the binary version, in docker it's set through volume mapping
# DOWNLOAD_DIR=/path/to/musiclibrary/explo/
# Download/move tracks to a subdirectory named after the playlist
# USE_SUBDIRECTORY=true
# Keep original file permissions when moving files (set to false on Synology devices)
# KEEP_PERMISSIONS=true
# Comma-separated list (no spaces) of download services, in priority order (supported: lidarr,slskd,youtube) (default: youtube)
# DOWNLOAD_SERVICES=youtube
# Only download complete albums: skip tracks whose release group is a single,
# EP, or similar. Needs ENRICH_TRACK_METADATA to know the release type;
# unenriched tracks are kept. (default: false)
# ALBUMS_ONLY=false
# Time budget (minutes) for a single download service before Explo gives up on it
# and lets the next service in DOWNLOAD_SERVICES try the remaining tracks.
# 0 (default) waits indefinitely. Example chain -- prefer full albums from Lidarr,
# fall back to slskd for anything it hasn't delivered in 15 minutes:
#   DOWNLOAD_SERVICES=lidarr,slskd
#   LIDARR_FALLBACK_AFTER=15
#   SLSKD_FALLBACK_AFTER=10
# LIDARR_FALLBACK_AFTER=0
# SLSKD_FALLBACK_AFTER=0
# Path templating, Options are Artist, Album, TrackName, TrackNumber, File, Ext (eg. "{{Artist}}/{{Album}}/{{File}}")
# PATH_TEMPLATE=""

# Directory for writing .m3u playlists (required only for MPD)
# PLAYLIST_DIR=/path/to/playlist/folder/

# === YouTube Configuration ===

# YouTube Data API key (optional, fall back is unofficial ytmusic API)
# YOUTUBE_API_KEY=
# Custom file extension for tracks (default: mp3)
# TRACK_EXTENSION=mp3
# Include cover art in downloaded files (default: false)
# EMBED_COVER_ART=false
# Custom path to ffmpeg binary (default: defined in $PATH)
# FFMPEG_PATH=
# Custom path to yt-dlp binary (default: defined in $PATH)
# YTDLP_PATH=
# Path to (optional) cookies file (default: ./cookies.txt) (in docker this is set through volume mapping)
# COOKIES_PATH=./cookies.txt
# Comma-separated (without spaces) keywords to exclude from YouTube results (default: live,remix,instrumental,extended,clean,acapella)
# FILTER_LIST=live,remix,instrumental,extended

# === Slskd Configuration ===

# Slskd instance address (requires running instance)
# SLSKD_URL=
# Slskd API key
# SLSKD_API_KEY=
# Whether to move downloads under the DOWNLOAD_DIR or not (default: false)
# SLSKD_MIGRATE_DOWNLOADS=false
# Overwrite track metadata when moving file (default: false)
# SLSKD_OVERWRITE_METADATA=false
# Download the whole release the matched file belongs to instead of just the
# recommended track. Only the recommended track is added to the playlist; the
# rest simply land in the library. Off by default -- it multiplies transfer
# volume per recommendation. (default: false)
# SLSKD_ALBUM_MODE=false
# Directory where slskd downloads tracks (default: /slskd/)
# PS! This is only needed on the binary version, in docker it's set through volume mapping
# SLSKD_DIR=/slskd/
# Number of times to check search status before skipping the track (default: 5)
# SLSKD_RETRY=5
# Number of download attempts for a track (default: 3)
# SLSKD_DL_ATTEMPTS=3

## Slskd Filtering

# Comma-separated (without spaces) file extensions to download from (default: flac,mp3)
# EXTENSIONS=flac,mp3
# Minimal Bit Depth (default: 8)
# MIN_BIT_DEPTH=8
# Minimal Bitrate (default: 256)
# MIN_BITRATE=256
# Highest bitrate in kbps to accept, so a single track cannot arrive as a 138 MB
# WAV. Worked out from file size when a peer reports no bitrate, so it applies
# to files that describe themselves and files that do not. 0 disables the
# ceiling. (default: 0)
# MAX_BITRATE=0
# Which end of the accepted range to reach for first. "none" leaves the order of
# EXTENSIONS deciding, as it always has. "smaller" takes the best lossy file and
# falls back to lossless only when there is none -- note it still prefers a 320
# over a 256, since wanting a small file does not mean wanting a bad one.
# "larger" is the reverse. Ranking only; nothing is rejected. (default: none)
# SIZE_PREFERENCE=none
# Which release album mode takes when several match. "fuller" takes the most
# complete directory, as it always has. "smaller" takes the one closest to the
# album's real track count, so a 21-track deluxe edition does not arrive in
# place of the 11-track album -- note this needs ENRICH_TRACK_METADATA, since
# that is where the real track count comes from, and falls back to "fuller"
# without it. (default: fuller)
# RELEASE_PREFERENCE=fuller
# Trim a release down to the original album before downloading it. Extra discs a
# peer has flattened into one directory are dropped (a real double album is kept
# whole when ENRICH_TRACK_METADATA confirms it), and bonus tracks appended past
# the album's real length are dropped after them. The recommended track is always
# kept, even when it is itself a bonus track. Set to false to take releases
# exactly as the peer shares them. (default: true)
# PREFER_ORIGINAL_RELEASE=true
# Comma-separated (without spaces) keywords to avoid, when filtering slskd results (default: live,remix,instrumental,extended,clean,acapella)
# FILTER_LIST=live,remix,instrumental,extended,clean,acapella

# === Lidarr Configuration ===

# Lidarr instance address (requires running instance)
# LIDARR_URL=
# Lidarr API key
# LIDARR_API_KEY=
# Root folder name to use in Lidarr (default: Music)
# LIDARR_ROOT_FOLDER=Music
# Whether to move downloads under the DOWNLOAD_DIR or not (default: false)
# LIDARR_MIGRATE_DOWNLOADS=false
# Directory where lidarr downloads tracks (default: /lidarr/)
# PS! This is only needed on the binary version, in docker it's set through volume mapping
# LIDARR_DIR=/lidarr/
# Number of times to check search status before skipping the album (default: 8)
# LIDARR_RETRY=8
# Time without download progress before the album is skipped (in minutes) (default: 20)
# LIDARR_STALL_DURATION=20
# Maximum time an album can remain in the download queue before being skipped (in minutes) (default: 120)
# LIDARR_MONITOR_MAX_DURATION=120

# === Metadata / Formatting ===

# Set to true to merge featured artists into title (recommended), false appends them to artist field (default: true)
# SINGLE_ARTIST=true
# Playlist name format: week (Weekly-Exploration-2026-Week5) or date (Weekly-Exploration-2026-01-31)
# PLAYLISTNAME_FORMAT=week
# Add more optional metadata to tracks (Track Number, Media type etc..) (default: false)
# ENRICH_TRACK_METADATA=false
# Cover art size in `px` to download (supported `250`, `500`, `1000`) (default: 250)
# COVER_ART_SIZE=250

# === Notifications ===

## Discord

# Application's (bot) token
# DISCORD_BOT_TOKEN=
# Channel ID where to send notifications (supports multiple IDs, use comma (without spaces) to separate them)
# DISCORD_CHANNEL_ID=

## HTTP

# HTTP URL to send POST requests to (supports multiple URLs, use comma (without spaces) to separate them)
# HTTP_RECEIVER=

## Matrix

# User ID for Matrix
# MATRIX_USERID=
# Room ID to send notifications in
# MATRIX_ROOMID=
# Homeserver URL that the room is created in
# MATRIX_HOMESERVER_URL=
# Users Access token
# MATRIX_ACCESSTOKEN=

# === Misc ===

# WIZARD_COMPLETE=false
# Minutes to sleep between library scans (default: 2)
# SLEEP=2
# Comma-separated list of MusicBrainz Artist IDs to exclude from import
# ARTIST_BLACKLIST=
# Set the log level (DEBUG, INFO, WARN, ERROR) (default: INFO)
# LOG_LEVEL=INFO
# Set a custom HTTP timeout for music servers (in seconds) (default: 10)
# CLIENT_HTTP_TIMEOUT=10